# ---------------------------------------------------------------------------
# Barnabas Insurance Brokers - environment variables
# Copy to .env.local for development, or set in the Vercel project settings.
# NOTHING in this file is real until you fill it in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Public (safe to expose to the browser) --------------------------------

# Canonical origin. Used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://barnabasinsurancebrokers.co.ke

# IRA Kenya broker licence number. Shown in the regulatory bar, the 500 page,
# the footer, the about page and the LocalBusiness JSON-LD.
NEXT_PUBLIC_IRA_LICENSE_NUMBER=IRA/BRK/0000/2025

# Association of Kenya Insurers membership number ("Member of AKI").
NEXT_PUBLIC_AKI_MEMBER_NUMBER=AKI/MEM/0000

# Brokerage contact details.
NEXT_PUBLIC_BROKER_PHONE=+254112272061
NEXT_PUBLIC_BROKER_EMAIL=info@barnabasinsurancebrokers.co.ke
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
NEXT_PUBLIC_OFFICE_ADDRESS=Kimathi Street, Nairobi CBD, Nairobi, Kenya
NEXT_PUBLIC_OFFICE_HOURS=Mon - Fri : 08 AM - 05 PM, Sat : 09 AM - 01 PM

# Google Maps embed URL for the contact section and the map in the footer.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=https://maps.google.com/maps?q=Nairobi%20CBD%2C%20Kenya&output=embed

# reCAPTCHA. Both keys are public by design; the secrets stay server-side.
# Leave NEXT_PUBLIC_RECAPTCHA_SITE_KEY empty to disable the widget in dev.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# v2 checkbox fallback, used when the v3 score is below RECAPTCHA_MIN_SCORE.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=

# Pexels attribution line rendered next to stock imagery (see image-credits.md).
NEXT_PUBLIC_PEXELS_ATTRIBUTION=Photos from Pexels

# --- Server only (never exposed to the browser) ----------------------------

# reCAPTCHA verification. Secret in environment variables only.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_V2_SECRET_KEY=
# v3 minimum score before the v2 checkbox fallback is required.
RECAPTCHA_MIN_SCORE=0.5
# false (default) = fail closed when the verification endpoint is unreachable.
# true = accept the submission but log a warning. Only set true if you accept
# that trade-off during an outage.
RECAPTCHA_FAIL_OPEN=false

# Vercel KV - quotations, group enquiries, subscribers, claim records, portal data.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob - claim supporting documents.
BLOB_READ_WRITE_TOKEN=

# Nodemailer SMTP for /api/contact and broker notification fallbacks.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Barnabas Insurance Brokers <no-reply@barnabasinsurancebrokers.co.ke>"
MAIL_TO_BROKER=quotes@barnabasinsurancebrokers.co.ke

# WhatsApp Cloud API. Without these the site still works: every lead is stored,
# emailed to the broker and returned with a pre-filled wa.me link for the team.
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Broker/brokerage WhatsApp number in international format, no plus sign.
WHATSAPP_BROKER_NUMBER=254112272061

# NextAuth (client portal). Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_EMAIL_FROM="Barnabas Insurance Brokers <no-reply@barnabasinsurancebrokers.co.ke>"

# Client portal. When true, the OTP is returned by the API and shown on screen
# instead of being emailed - development and preview only, never production.
PORTAL_DEMO_MODE=false

# Bearer token for the broker-team comparison dataset admin route
# (PUT /api/comparison). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Build-time Pexels fetch (npm run fetch-pexels). Server-side only.
PEXELS_API_KEY=
